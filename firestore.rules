rules_version = '2';

// ===============================================================
// Assumed Data Model — Dấu Ấn Việt 3D (Chunked 3-Tier Cloud Sync)
// ===============================================================
//
// Collection: /heritage_sites/{siteId}
//   - Public museum catalog metadata (zero PII). Public read; Admin-only validated write.
//
// Collection: /site_models/{siteId}
//   - 3D model URLs / chunk pointers, scale/rotation/dissection calibration & hotspots.
//     Public read; Admin-only write.
//
// Collection: /site_audio/{siteId}
//   - Audio narration URLs / chunk pointers & script overrides. Public read; Admin-only write.
//
// Collection: /cloud_assets_meta/{docId}
//   - Chunked binary asset manifest ({ assetType, siteId, fileName, mimeType, totalChunks,
//     totalSize, updatedAt, checksum }). Public read for cross-device / Remix hydration;
//     Admin-only write.
//
// Collection: /cloud_assets_chunks/{docId}
//   - Individual 350KB Base64 chunks ({ assetType, siteId, chunkIndex, totalChunks, data,
//     updatedAt }) supporting up to 25MB/file on Firebase free tier without Cloud Storage.
//     Public read; Admin-only write.
//
// Collection: /_healthCheck/{docId}
//   - Live read/write connectivity probe used by Admin Studio. Public get; Admin-only write.
//
// Collection: /media_credits/{chunkId}
//   - Chunked archival citations (<= 35 entries per chunk). Public read; Admin-only write.
//
// Collection: /global_settings/{docId}
//   - Global site display settings and hidden monument IDs. Public read; Admin-only write.
//
// Collection: /heritage_cloud_sync/{docId}
//   - Master manifest containing `updatedAt` timestamp for Local vs Cloud conflict comparison.
//     Public read; Admin-only write.
//
// Collection: /admins/{uid}
//   - Verified administrator allowlist. Self/Admin get; Admin-only list & write.
//
// Collection: /payment_orders/{orderId}
//   - VietQR payment orders. Buyer can create pending order & submit waiting_approval;
//     Admin can list, approve (paid), reject, or delete.
//
// Document: /test/connection
//   - Read-only connectivity probe document.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 160 && id.matches('^[a-zA-Z0-9._-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          request.auth.token.email_verified == true &&
          (
            request.auth.token.email == 'hoanghairaumau36@gmail.com' ||
            request.auth.token.email == 'hoanghailqd2026@gmail.com' ||
            request.auth.token.email == 'bivsmoon2023@gmail.com'
          )
        )
      );
    }

    function isValidTimestampString(val) {
      return val is string && val.size() >= 10 && val.size() <= 64;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidHeritageSite(data) {
      return data.keys().hasAll(['siteId', 'updatedAt']) &&
        data.siteId is string && data.siteId.size() >= 1 && data.siteId.size() <= 64 &&
        isValidTimestampString(data.updatedAt) &&
        isOptionalString(data, 'code', 16) &&
        isOptionalString(data, 'officialName', 300) &&
        isOptionalString(data, 'visibility', 32) &&
        isOptionalString(data, 'summary', 20000) &&
        isOptionalString(data, 'chronology', 20000) &&
        isOptionalString(data, 'architecturalStyle', 20000) &&
        isOptionalString(data, 'conservationNotes', 20000) &&
        (!('photos' in data) || (data.photos is list && data.photos.size() <= 12));
    }

    function isValidSiteModel(data) {
      return data.keys().hasAll(['siteId', 'updatedAt']) &&
        data.siteId is string && data.siteId.size() >= 1 && data.siteId.size() <= 64 &&
        isValidTimestampString(data.updatedAt) &&
        isOptionalString(data, 'modelUrl', 4096) &&
        isOptionalString(data, 'fileName', 256) &&
        isOptionalString(data, 'storagePath', 512) &&
        (!('fileSize' in data) || data.fileSize == null || (data.fileSize is number && data.fileSize >= 0)) &&
        (!('scale' in data) || (data.scale is number && data.scale > 0 && data.scale <= 100)) &&
        (!('rotationY' in data) || data.rotationY is number) &&
        (!('explosionFactor' in data) || (data.explosionFactor is number && data.explosionFactor >= 0 && data.explosionFactor <= 10)) &&
        (!('layerOffsets' in data) || (data.layerOffsets is list && data.layerOffsets.size() <= 8)) &&
        (!('hotspots' in data) || (data.hotspots is list && data.hotspots.size() <= 50));
    }

    function isValidSiteAudio(data) {
      return data.keys().hasAll(['siteId', 'updatedAt']) &&
        data.siteId is string && data.siteId.size() >= 1 && data.siteId.size() <= 64 &&
        isValidTimestampString(data.updatedAt) &&
        isOptionalString(data, 'audioUrl', 4096) &&
        isOptionalString(data, 'fileName', 256) &&
        isOptionalString(data, 'storagePath', 512) &&
        (!('fileSize' in data) || data.fileSize == null || (data.fileSize is number && data.fileSize >= 0)) &&
        (!('durationSec' in data) || data.durationSec == null || (data.durationSec is number && data.durationSec >= 0));
    }

    function isValidCloudAssetMeta(data) {
      return data.keys().hasAll(['assetType', 'siteId', 'fileName', 'mimeType', 'totalChunks', 'totalSize', 'updatedAt', 'checksum']) &&
        data.assetType in ['models', 'audio', 'images', 'videos'] &&
        data.siteId is string && data.siteId.size() >= 1 && data.siteId.size() <= 120 &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 256 &&
        data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 128 &&
        data.totalChunks is number && data.totalChunks >= 1 && data.totalChunks <= 120 &&
        data.totalSize is number && data.totalSize >= 1 && data.totalSize <= 26214400 &&
        data.checksum is string && data.checksum.size() >= 1 && data.checksum.size() <= 128 &&
        isValidTimestampString(data.updatedAt);
    }

    function isValidCloudAssetChunk(data) {
      return data.keys().hasAll(['assetType', 'siteId', 'chunkIndex', 'totalChunks', 'data', 'updatedAt']) &&
        data.assetType in ['models', 'audio', 'images', 'videos'] &&
        data.siteId is string && data.siteId.size() >= 1 && data.siteId.size() <= 120 &&
        data.chunkIndex is number && data.chunkIndex >= 0 && data.chunkIndex < 120 &&
        data.totalChunks is number && data.totalChunks >= 1 && data.totalChunks <= 120 &&
        data.data is string && data.data.size() >= 1 && data.data.size() <= 550000 &&
        isValidTimestampString(data.updatedAt);
    }

    function isValidSiteVideo(data) {
      return data.keys().hasAll(['siteId', 'updatedAt']) &&
        data.siteId is string && data.siteId.size() >= 1 && data.siteId.size() <= 64 &&
        isValidTimestampString(data.updatedAt) &&
        isOptionalString(data, 'videoKey', 16) &&
        isOptionalString(data, 'customUrl', 4096) &&
        isOptionalString(data, 'embedUrl', 4096) &&
        isOptionalString(data, 'kind', 32) &&
        isOptionalString(data, 'titleVi', 400) &&
        isOptionalString(data, 'titleEn', 400) &&
        isOptionalString(data, 'titleZh', 400) &&
        isOptionalString(data, 'sourceNote', 500) &&
        isOptionalString(data, 'chunkAssetKey', 120);
    }

    function isValidSyncStateDoc(data) {
      return data.keys().hasAll(['branch', 'updatedAt']) &&
        data.branch is string && data.branch.size() >= 1 && data.branch.size() <= 64 &&
        isValidTimestampString(data.updatedAt) &&
        (!('itemCount' in data) || (data.itemCount is number && data.itemCount >= 0 && data.itemCount <= 10000));
    }

    function isValidHealthCheckProbe(data) {
      return data.keys().hasAll(['ok', 'timestamp']) &&
        data.ok is bool &&
        isValidTimestampString(data.timestamp) &&
        isOptionalString(data, 'checkedBy', 256) &&
        isOptionalString(data, 'transport', 64);
    }

    function isValidMediaCreditsChunk(data) {
      return data.keys().hasAll(['chunkIndex', 'totalChunks', 'items', 'updatedAt']) &&
        data.chunkIndex is number && data.chunkIndex >= 0 && data.chunkIndex < 100 &&
        data.totalChunks is number && data.totalChunks >= 1 && data.totalChunks <= 100 &&
        data.items is list && data.items.size() <= 50 &&
        isValidTimestampString(data.updatedAt);
    }

    function isValidGlobalSettings(data) {
      return data.keys().hasAll(['updatedAt']) &&
        isValidTimestampString(data.updatedAt) &&
        isOptionalString(data, 'bakedVersion', 128) &&
        (!('hiddenHeritageIds' in data) || (data.hiddenHeritageIds is list && data.hiddenHeritageIds.size() <= 100));
    }

    function isValidSyncManifest(data) {
      return data.keys().hasAll(['updatedAt']) &&
        isValidTimestampString(data.updatedAt) &&
        isOptionalString(data, 'lastGlobalSyncAt', 64) &&
        isOptionalString(data, 'version', 128) &&
        isOptionalString(data, 'pushedBy', 256) &&
        (!('siteCount' in data) || (data.siteCount is number && data.siteCount >= 0 && data.siteCount <= 500));
    }

    function isValidPaymentOrder(data) {
      return data.keys().hasAll([
          'orderId', 'uid', 'email', 'displayName', 'packageId',
          'packageName', 'quantity', 'amount', 'transferContent', 'status', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'orderId', 'uid', 'email', 'displayName', 'packageId', 'packageName',
          'quantity', 'amount', 'transferContent', 'status', 'receiptImage', 'createdAt',
          'planTier', 'routeId', 'siteId', 'scopeLabel', 'schoolName', 'schoolProvince',
          'ticketCode', 'rejectionReason', 'submittedAt', 'approvedAt', 'approvedBy',
          'emailSent', 'notificationSent', 'popupNotified', 'updatedAt'
        ]) &&
        data.orderId is string && data.orderId.size() >= 8 && data.orderId.size() <= 20 &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 160 &&
        data.email is string && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 160 &&
        data.packageId in ['student_25k', 'self_guided_59k', 'classroom_500k'] &&
        data.packageName is string && data.packageName.size() >= 1 && data.packageName.size() <= 200 &&
        data.quantity is int && data.quantity >= 1 && data.quantity <= 50 &&
        data.amount is number && data.amount >= 25000 && data.amount <= 5000000 &&
        data.transferContent is string && data.transferContent.size() >= 8 && data.transferContent.size() <= 20 &&
        data.status in ['pending', 'waiting_approval', 'paid', 'rejected'] &&
        isValidTimestampString(data.createdAt) &&
        isOptionalString(data, 'receiptImage', 300000) &&
        isOptionalString(data, 'planTier', 16) &&
        isOptionalString(data, 'routeId', 64) &&
        isOptionalString(data, 'siteId', 64) &&
        isOptionalString(data, 'scopeLabel', 300) &&
        isOptionalString(data, 'schoolName', 200) &&
        isOptionalString(data, 'schoolProvince', 100) &&
        isOptionalString(data, 'ticketCode', 64) &&
        isOptionalString(data, 'rejectionReason', 500) &&
        isOptionalString(data, 'submittedAt', 64) &&
        isOptionalString(data, 'approvedAt', 64) &&
        isOptionalString(data, 'approvedBy', 254) &&
        isOptionalString(data, 'updatedAt', 64) &&
        (!('emailSent' in data) || data.emailSent is bool) &&
        (!('notificationSent' in data) || data.notificationSent is bool) &&
        (!('popupNotified' in data) || data.popupNotified is bool);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'tier', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'email', 'displayName', 'provider', 'photoURL', 'tier',
          'unlockedSiteIds', 'unlockedRouteIds', 'hasSchoolPackage',
          'isSuspended', 'suspendedAt', 'suspendedBy', 'schoolName',
          'schoolCode', 'ticketCodes', 'activeOrderIds', 'exploredSiteIds',
          'bestQuizScore', 'quizAttempts', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 160 &&
        data.tier in ['basic', 'plus', 'pro', 'school'] &&
        isValidTimestampString(data.updatedAt) &&
        isOptionalString(data, 'email', 254) &&
        isOptionalString(data, 'displayName', 160) &&
        (!('provider' in data) || data.provider in ['google', 'facebook', 'password']) &&
        isOptionalString(data, 'photoURL', 1024) &&
        (!('unlockedSiteIds' in data) || (data.unlockedSiteIds is list && data.unlockedSiteIds.size() <= 50)) &&
        (!('unlockedRouteIds' in data) || (data.unlockedRouteIds is list && data.unlockedRouteIds.size() <= 30)) &&
        (!('hasSchoolPackage' in data) || data.hasSchoolPackage is bool) &&
        (!('isSuspended' in data) || data.isSuspended is bool) &&
        isOptionalString(data, 'suspendedAt', 64) &&
        isOptionalString(data, 'suspendedBy', 254) &&
        isOptionalString(data, 'schoolName', 200) &&
        isOptionalString(data, 'schoolCode', 64) &&
        (!('ticketCodes' in data) || (data.ticketCodes is list && data.ticketCodes.size() <= 100)) &&
        (!('activeOrderIds' in data) || (data.activeOrderIds is list && data.activeOrderIds.size() <= 100)) &&
        (!('exploredSiteIds' in data) || (
          data.exploredSiteIds is list &&
          data.exploredSiteIds.size() <= 17 &&
          (data.exploredSiteIds.size() == 0 || data.exploredSiteIds[0] is string)
        )) &&
        (!('bestQuizScore' in data) || (data.bestQuizScore is int && data.bestQuizScore >= 0 && data.bestQuizScore <= 100)) &&
        (!('quizAttempts' in data) || (data.quizAttempts is int && data.quizAttempts >= 0 && data.quizAttempts <= 10000));
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['id', 'uid', 'visitorName', 'rating', 'comment', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'uid', 'userEmail', 'userName', 'visitorName', 'provider',
          'contactDisplay', 'visitorRole', 'visitorRoleLabel', 'rating', 'tags',
          'favoriteSiteId', 'favoriteSiteName', 'comment', 'createdAt',
          'isPinned', 'adminReply', 'adminRepliedAt', 'adminRepliedBy'
        ]) &&
        data.id is string && data.id.size() >= 4 && data.id.size() <= 160 &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 160 &&
        data.visitorName is string && data.visitorName.size() >= 1 && data.visitorName.size() <= 160 &&
        data.rating is int && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 10 && data.comment.size() <= 1000 &&
        isValidTimestampString(data.createdAt) &&
        isOptionalString(data, 'userId', 160) &&
        isOptionalString(data, 'userEmail', 254) &&
        isOptionalString(data, 'userName', 160) &&
        isOptionalString(data, 'provider', 32) &&
        isOptionalString(data, 'contactDisplay', 256) &&
        isOptionalString(data, 'visitorRole', 32) &&
        isOptionalString(data, 'visitorRoleLabel', 120) &&
        isOptionalString(data, 'favoriteSiteId', 64) &&
        isOptionalString(data, 'favoriteSiteName', 200) &&
        isOptionalString(data, 'adminReply', 2000) &&
        isOptionalString(data, 'adminRepliedAt', 64) &&
        isOptionalString(data, 'adminRepliedBy', 254) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 10)) &&
        (!('isPinned' in data) || data.isPinned is bool);
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll([
          'id', 'ticketCode', 'uid', 'senderName', 'senderEmail',
          'category', 'description', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ticketCode', 'uid', 'userEmail', 'userName', 'senderUserId', 'ownerEmail',
          'guestSessionId', 'senderName', 'senderEmail', 'senderPhone', 'category',
          'categoryLabel', 'relatedSiteId', 'relatedSiteName', 'description', 'status',
          'createdAt', 'updatedAt', 'adminReply', 'adminRepliedAt', 'adminRepliedBy',
          'visitorReadReply', 'aiPriority', 'aiSummary', 'forwardedToEmail', 'forwardedAt',
          'messages', 'aiAutoReplied', 'escalatedToAdmin', 'escalatedAt', 'supportTier',
          'retentionDays', 'testerContext'
        ]) &&
        data.id is string && data.id.size() >= 4 && data.id.size() <= 160 &&
        data.ticketCode is string && data.ticketCode.size() >= 3 && data.ticketCode.size() <= 32 &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 160 &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 160 &&
        data.senderEmail is string && data.senderEmail.size() >= 3 && data.senderEmail.size() <= 254 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 64 &&
        data.description is string && data.description.size() >= 10 && data.description.size() <= 1000 &&
        data.status in ['pending', 'in_progress', 'resolved'] &&
        isValidTimestampString(data.createdAt) &&
        isValidTimestampString(data.updatedAt) &&
        isOptionalString(data, 'userEmail', 254) &&
        isOptionalString(data, 'userName', 160) &&
        isOptionalString(data, 'senderUserId', 160) &&
        isOptionalString(data, 'ownerEmail', 254) &&
        isOptionalString(data, 'guestSessionId', 160) &&
        isOptionalString(data, 'senderPhone', 40) &&
        isOptionalString(data, 'categoryLabel', 160) &&
        isOptionalString(data, 'relatedSiteId', 64) &&
        isOptionalString(data, 'relatedSiteName', 200) &&
        isOptionalString(data, 'adminReply', 4000) &&
        isOptionalString(data, 'adminRepliedAt', 64) &&
        isOptionalString(data, 'adminRepliedBy', 254) &&
        isOptionalString(data, 'aiPriority', 64) &&
        isOptionalString(data, 'aiSummary', 500) &&
        isOptionalString(data, 'forwardedToEmail', 254) &&
        isOptionalString(data, 'forwardedAt', 64) &&
        isOptionalString(data, 'escalatedAt', 64) &&
        isOptionalString(data, 'supportTier', 64) &&
        (!('visitorReadReply' in data) || data.visitorReadReply is bool) &&
        (!('aiAutoReplied' in data) || data.aiAutoReplied is bool) &&
        (!('escalatedToAdmin' in data) || data.escalatedToAdmin is bool) &&
        (!('retentionDays' in data) || (data.retentionDays is number && data.retentionDays >= 0 && data.retentionDays <= 3650)) &&
        (!('messages' in data) || (data.messages is list && data.messages.size() <= 100)) &&
        (!('testerContext' in data) || data.testerContext is map);
    }

    function isTeacherSchoolEntitled(teacherUid) {
      return exists(/databases/$(database)/documents/users/$(teacherUid)) && (
        get(/databases/$(database)/documents/users/$(teacherUid)).data.tier == 'school' ||
        get(/databases/$(database)/documents/users/$(teacherUid)).data.hasSchoolPackage == true
      );
    }

    function isValidClassroomAssignment(assignment) {
      return assignment == null || (
        assignment is map &&
        assignment.keys().hasAll(['id', 'title', 'regionTopic', 'requiredQuizCount', 'updatedAt']) &&
        assignment.keys().hasOnly(['id', 'title', 'regionTopic', 'requiredQuizCount', 'deadline', 'updatedAt']) &&
        assignment.id is string && assignment.id.size() >= 1 && assignment.id.size() <= 64 &&
        assignment.title is string && assignment.title.size() >= 1 && assignment.title.size() <= 200 &&
        assignment.regionTopic in ['all', 'hcm', 'bd', 'brvt'] &&
        assignment.requiredQuizCount is int && assignment.requiredQuizCount >= 1 && assignment.requiredQuizCount <= 100 &&
        isOptionalString(assignment, 'deadline', 64) &&
        isValidTimestampString(assignment.updatedAt)
      );
    }

    function isValidClassroomLicense(data) {
      return data.keys().hasAll([
          'teacherUid', 'teacherEmail', 'teacherName', 'inviteCode',
          'maxSeats', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'teacherUid', 'teacherEmail', 'teacherName', 'orderId', 'schoolName',
          'className', 'classNote', 'inviteCode', 'inviteCodeLocked', 'assignment',
          'maxSeats', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.teacherUid is string && data.teacherUid.size() >= 1 && data.teacherUid.size() <= 160 &&
        data.teacherEmail is string && data.teacherEmail.size() <= 254 &&
        data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 160 &&
        isOptionalString(data, 'orderId', 64) &&
        isOptionalString(data, 'schoolName', 200) &&
        isOptionalString(data, 'className', 200) &&
        isOptionalString(data, 'classNote', 300) &&
        data.inviteCode is string && data.inviteCode.size() >= 6 && data.inviteCode.size() <= 32 &&
        data.inviteCode.matches('^[A-Z0-9-]+$') &&
        (!('inviteCodeLocked' in data) || data.inviteCodeLocked is bool) &&
        (!('assignment' in data) || isValidClassroomAssignment(data.assignment)) &&
        data.maxSeats is int && data.maxSeats >= 1 && data.maxSeats <= 35 &&
        data.active is bool &&
        isValidTimestampString(data.createdAt) &&
        isValidTimestampString(data.updatedAt);
    }

    function isValidClassroomInvite(data) {
      return data.keys().hasAll([
          'inviteCode', 'teacherUid', 'teacherName', 'maxSeats',
          'seatCount', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'inviteCode', 'teacherUid', 'teacherName', 'schoolName',
          'className', 'classNote', 'inviteCodeLocked', 'assignment',
          'maxSeats', 'seatCount', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.inviteCode is string && data.inviteCode.size() >= 6 && data.inviteCode.size() <= 32 &&
        data.inviteCode.matches('^[A-Z0-9-]+$') &&
        data.teacherUid is string && data.teacherUid.size() >= 1 && data.teacherUid.size() <= 160 &&
        data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 160 &&
        isOptionalString(data, 'schoolName', 200) &&
        isOptionalString(data, 'className', 200) &&
        isOptionalString(data, 'classNote', 300) &&
        (!('inviteCodeLocked' in data) || data.inviteCodeLocked is bool) &&
        (!('assignment' in data) || isValidClassroomAssignment(data.assignment)) &&
        data.maxSeats is int && data.maxSeats >= 1 && data.maxSeats <= 35 &&
        data.seatCount is int && data.seatCount >= 0 && data.seatCount <= data.maxSeats &&
        data.active is bool &&
        isValidTimestampString(data.createdAt) &&
        isValidTimestampString(data.updatedAt);
    }

    function isValidClassroomGrant(data) {
      return data.keys().hasAll([
          'grantId', 'teacherUid', 'teacherName', 'inviteCode',
          'studentEmail', 'method', 'status', 'grantedAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'grantId', 'teacherUid', 'teacherName', 'schoolName', 'className', 'inviteCode',
          'studentEmail', 'studentUid', 'studentName', 'displayName', 'groupName',
          'method', 'status', 'exploredSiteIds', 'exploredCount', 'quizAttempts',
          'bestQuizScore', 'activatedAt', 'grantedAt', 'updatedAt'
        ]) &&
        data.grantId is string && data.grantId.size() >= 4 && data.grantId.size() <= 200 &&
        data.teacherUid is string && data.teacherUid.size() >= 1 && data.teacherUid.size() <= 160 &&
        data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 160 &&
        isOptionalString(data, 'schoolName', 200) &&
        isOptionalString(data, 'className', 200) &&
        data.inviteCode is string && data.inviteCode.size() >= 6 && data.inviteCode.size() <= 32 &&
        data.studentEmail is string && data.studentEmail.size() <= 254 &&
        isOptionalString(data, 'studentUid', 160) &&
        isOptionalString(data, 'studentName', 160) &&
        isOptionalString(data, 'displayName', 160) &&
        isOptionalString(data, 'groupName', 80) &&
        data.method in ['teacher_email', 'invite_code'] &&
        data.status in ['active', 'pending', 'suspended', 'revoked'] &&
        (!('exploredSiteIds' in data) || (
          data.exploredSiteIds is list &&
          data.exploredSiteIds.size() <= 17 &&
          (data.exploredSiteIds.size() == 0 || data.exploredSiteIds[0] is string)
        )) &&
        (!('exploredCount' in data) || (data.exploredCount is int && data.exploredCount >= 0 && data.exploredCount <= 17)) &&
        (!('quizAttempts' in data) || (data.quizAttempts is int && data.quizAttempts >= 0 && data.quizAttempts <= 10000)) &&
        (!('bestQuizScore' in data) || (data.bestQuizScore is int && data.bestQuizScore >= 0 && data.bestQuizScore <= 100)) &&
        isOptionalString(data, 'activatedAt', 64) &&
        isValidTimestampString(data.grantedAt) &&
        isValidTimestampString(data.updatedAt);
    }

    function isValidCmsHeritageSite3D(data) {
      return data.keys().hasAll(['siteId', 'is3DModelHidden', 'updatedAt']) &&
        data.keys().hasOnly(['siteId', 'is3DModelHidden', 'hidden3DReason', 'updatedAt', 'updatedBy']) &&
        data.siteId is string && data.siteId.size() >= 1 && data.siteId.size() <= 64 &&
        data.is3DModelHidden is bool &&
        isOptionalString(data, 'hidden3DReason', 600) &&
        isValidTimestampString(data.updatedAt) &&
        isOptionalString(data, 'updatedBy', 160);
    }

    function isValidSystemSetting3DConfig(data) {
      return data.keys().hasAll(['isGlobal3DHidden', 'globalHiddenReason', 'updatedAt']) &&
        data.keys().hasOnly(['isGlobal3DHidden', 'globalHiddenReason', 'updatedAt', 'updatedBy']) &&
        data.isGlobal3DHidden is bool &&
        data.globalHiddenReason is string && data.globalHiddenReason.size() >= 1 && data.globalHiddenReason.size() <= 600 &&
        isValidTimestampString(data.updatedAt) &&
        isOptionalString(data, 'updatedBy', 160);
    }

    function isValidCmsEvent(data) {
      return data.keys().hasAll([
          'id', 'title', 'category', 'startDate', 'endDate', 'location',
          'summary', 'content', 'isFeatured', 'isHidden', 'createdBy', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'title', 'titleEn', 'titleZh', 'category', 'startDate', 'endDate',
          'location', 'relatedSiteId', 'coverImageUrl', 'summary', 'content',
          'registrationUrl', 'isFeatured', 'isHidden', 'createdBy', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 120 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 220 &&
        isOptionalString(data, 'titleEn', 220) &&
        isOptionalString(data, 'titleZh', 220) &&
        data.category in ['Triển lãm số', 'Cuộc thi Sử học', 'Hội thảo / Workshop', 'Bảo tồn Di sản', 'Thông báo'] &&
        data.startDate is string && data.startDate.size() >= 1 && data.startDate.size() <= 32 &&
        data.endDate is string && data.endDate.size() >= 1 && data.endDate.size() <= 32 &&
        data.location is string && data.location.size() >= 1 && data.location.size() <= 200 &&
        isOptionalString(data, 'relatedSiteId', 64) &&
        isOptionalString(data, 'coverImageUrl', 280000) &&
        data.summary is string && data.summary.size() <= 1000 &&
        data.content is string && data.content.size() <= 12000 &&
        isOptionalString(data, 'registrationUrl', 1024) &&
        data.isFeatured is bool &&
        data.isHidden is bool &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 160 &&
        isValidTimestampString(data.updatedAt);
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll([
          'id', 'action', 'actorUid', 'actorEmail', 'actorName',
          'detail', 'deviceLabel', 'locationDisplay', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'action', 'actorUid', 'actorEmail', 'actorName',
          'targetId', 'detail', 'deviceLabel', 'locationDisplay', 'createdAt'
        ]) &&
        data.id is string && data.id.size() >= 4 && data.id.size() <= 160 &&
        data.action in [
          'REGISTER_PASSWORD', 'LOGIN_PASSWORD', 'LOGIN_OAUTH', 'PASSWORD_RESET_SENT',
          'USER_SUSPEND_TOGGLE', 'CMS_EVENT_UPDATE', 'CMS_TOGGLE_3D', 'SYSTEM_ADMIN_ACTION'
        ] &&
        data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 160 &&
        data.actorEmail is string && data.actorEmail.size() <= 254 &&
        data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 160 &&
        isOptionalString(data, 'targetId', 120) &&
        data.detail is string && data.detail.size() <= 1000 &&
        data.deviceLabel is string && data.deviceLabel.size() <= 160 &&
        data.locationDisplay is string && data.locationDisplay.size() <= 160 &&
        isValidTimestampString(data.createdAt);
    }

    // -------------------------------------------------------------
    // Read-Only Startup Health Probe & Admin Write Health Check
    // -------------------------------------------------------------
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    match /_healthCheck/{docId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(docId) && isValidHealthCheckProbe(request.resource.data);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // Chunked Binary Assets (3D .GLB, 17 Audio, Uploaded Images & Videos)
    // -------------------------------------------------------------
    match /cloud_assets_meta/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(docId) && isValidCloudAssetMeta(request.resource.data);
      allow delete: if isAdmin();
    }

    match /cloud_assets_chunks/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(docId) && isValidCloudAssetChunk(request.resource.data);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // Public Heritage Catalog & Unified Multi-Asset Sync Collections
    // -------------------------------------------------------------
    match /heritage_sites/{siteId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(siteId) && isValidHeritageSite(request.resource.data);
      allow delete: if isAdmin();
    }

    match /site_models/{siteId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(siteId) && isValidSiteModel(request.resource.data);
      allow delete: if isAdmin();
    }

    match /site_audio/{siteId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(siteId) && isValidSiteAudio(request.resource.data);
      allow delete: if isAdmin();
    }

    match /site_videos/{siteId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(siteId) && isValidSiteVideo(request.resource.data);
      allow delete: if isAdmin();
    }

    match /sync_state/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(docId) && isValidSyncStateDoc(request.resource.data);
      allow delete: if isAdmin();
    }

    match /media_credits/{chunkId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(chunkId) && isValidMediaCreditsChunk(request.resource.data);
      allow delete: if isAdmin();
    }

    match /global_settings/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(docId) && isValidGlobalSettings(request.resource.data);
      allow delete: if isAdmin();
    }

    match /heritage_cloud_sync/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(docId) && isValidSyncManifest(request.resource.data);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // Admin Allowlist (No Self-Escalation)
    // -------------------------------------------------------------
    match /admins/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasAll(['uid', 'email', 'role']) &&
        request.resource.data.uid == uid &&
        request.resource.data.email is string &&
        request.resource.data.role in ['admin', 'super_admin'];
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // Per-Account Ticket Ownership & Unlocked Entitlements (/users/{uid})
    // -------------------------------------------------------------
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(uid) &&
        isValidUserProfile(request.resource.data) && (
          isAdmin() || (
            isSignedIn() &&
            request.auth.uid == uid &&
            request.resource.data.uid == uid &&
            request.resource.data.tier == 'basic' &&
            request.resource.data.get('hasSchoolPackage', false) == false &&
            request.resource.data.get('isSuspended', false) == false &&
            request.resource.data.get('unlockedSiteIds', []).size() == 0 &&
            request.resource.data.get('unlockedRouteIds', []).size() == 0 &&
            request.resource.data.get('ticketCodes', []).size() == 0 &&
            request.resource.data.get('activeOrderIds', []).size() == 0
          )
        );
      allow update: if isValidId(uid) &&
        isValidUserProfile(request.resource.data) && (
          isAdmin() || (
            isSignedIn() &&
            request.auth.uid == uid &&
            request.resource.data.uid == resource.data.uid &&
            request.resource.data.tier == resource.data.tier &&
            request.resource.data.get('hasSchoolPackage', false) == resource.data.get('hasSchoolPackage', false) &&
            request.resource.data.get('isSuspended', false) == resource.data.get('isSuspended', false) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'email', 'displayName', 'provider', 'photoURL',
              'exploredSiteIds', 'bestQuizScore', 'quizAttempts', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // VietQR Payment Orders (Strict UID Isolation; Admin Approval Only)
    // -------------------------------------------------------------
    match /payment_orders/{orderId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        isValidId(orderId) &&
        isValidPaymentOrder(request.resource.data) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.orderId == orderId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.get('notificationSent', false) == false;
      allow update: if isValidId(orderId) &&
        isValidPaymentOrder(request.resource.data) && (
          isAdmin() || (
            isSignedIn() &&
            resource.data.uid == request.auth.uid &&
            request.resource.data.uid == resource.data.uid &&
            request.resource.data.orderId == resource.data.orderId &&
            request.resource.data.amount == resource.data.amount &&
            request.resource.data.packageId == resource.data.packageId &&
            request.resource.data.quantity == resource.data.quantity &&
            request.resource.data.createdAt == resource.data.createdAt && (
              (
                resource.data.status in ['pending', 'rejected'] &&
                request.resource.data.status == 'waiting_approval' &&
                (resource.data.get('notificationSent', false) != true || request.resource.data.notificationSent == true) &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'status', 'receiptImage', 'rejectionReason', 'submittedAt', 'notificationSent', 'updatedAt'
                ])
              ) || (
                resource.data.status in ['pending', 'waiting_approval'] &&
                request.resource.data.status == 'rejected' &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'status', 'rejectionReason', 'updatedAt'
                ])
              ) || (
                resource.data.status == 'paid' &&
                request.resource.data.status == 'paid' &&
                request.resource.data.popupNotified == true &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'popupNotified', 'updatedAt'
                ])
              )
            )
          )
        );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // Authenticated Visitor Feedbacks (/feedbacks/{feedbackId})
    // -------------------------------------------------------------
    match /feedbacks/{feedbackId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        isValidId(feedbackId) &&
        isValidFeedback(request.resource.data) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.id == feedbackId;
      allow update: if isAdmin() && isValidId(feedbackId) && isValidFeedback(request.resource.data);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // Authenticated Customer Support Tickets (/support_tickets/{ticketId})
    // -------------------------------------------------------------
    match /support_tickets/{ticketId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        isValidId(ticketId) &&
        isValidSupportTicket(request.resource.data) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.id == ticketId &&
        request.resource.data.status == 'pending';
      allow update: if isValidId(ticketId) &&
        isValidSupportTicket(request.resource.data) && (
          isAdmin() || (
            isSignedIn() &&
            resource.data.uid == request.auth.uid &&
            request.resource.data.uid == resource.data.uid &&
            request.resource.data.id == resource.data.id &&
            request.resource.data.ticketCode == resource.data.ticketCode &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'messages', 'escalatedToAdmin', 'escalatedAt', 'visitorReadReply', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // Classroom 500k Licenses & 35-Student Pro Grants
    // -------------------------------------------------------------
    match /classroom_licenses/{teacherUid} {
      allow get: if isValidId(teacherUid) && (
        isAdmin() || (isSignedIn() && request.auth.uid == teacherUid)
      );
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
        isValidId(teacherUid) &&
        isValidClassroomLicense(request.resource.data) &&
        request.resource.data.teacherUid == teacherUid && (
          isAdmin() || (
            request.auth.uid == teacherUid &&
            isTeacherSchoolEntitled(teacherUid)
          )
        );
      allow update: if isSignedIn() &&
        isValidId(teacherUid) &&
        isValidClassroomLicense(request.resource.data) &&
        request.resource.data.teacherUid == resource.data.teacherUid &&
        request.resource.data.createdAt == resource.data.createdAt && (
          isAdmin() || (
            request.auth.uid == teacherUid &&
            isTeacherSchoolEntitled(teacherUid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'inviteCode', 'schoolName', 'className', 'classNote',
              'inviteCodeLocked', 'assignment', 'active', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin();
    }

    match /classroom_invites/{inviteCode} {
      allow get: if isSignedIn() && isValidId(inviteCode);
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
        isValidId(inviteCode) &&
        isValidClassroomInvite(request.resource.data) &&
        request.resource.data.inviteCode == inviteCode && (
          isAdmin() || (
            request.resource.data.teacherUid == request.auth.uid &&
            isTeacherSchoolEntitled(request.auth.uid)
          )
        );
      allow update: if isSignedIn() &&
        isValidId(inviteCode) &&
        isValidClassroomInvite(request.resource.data) &&
        request.resource.data.inviteCode == resource.data.inviteCode &&
        request.resource.data.teacherUid == resource.data.teacherUid &&
        request.resource.data.createdAt == resource.data.createdAt && (
          isAdmin() || (
            resource.data.teacherUid == request.auth.uid &&
            isTeacherSchoolEntitled(request.auth.uid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'active', 'seatCount', 'teacherName', 'schoolName',
              'className', 'classNote', 'inviteCodeLocked', 'assignment', 'updatedAt'
            ])
          ) || (
            resource.data.active == true &&
            resource.data.get('inviteCodeLocked', false) != true &&
            request.resource.data.active == true &&
            request.resource.data.maxSeats == resource.data.maxSeats &&
            request.resource.data.seatCount == resource.data.seatCount + 1 &&
            request.resource.data.seatCount <= resource.data.maxSeats &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'seatCount', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(inviteCode) && (
        isAdmin() || (isSignedIn() && resource.data.teacherUid == request.auth.uid)
      );
    }

    match /classroom_grants/{grantId} {
      allow get: if isValidId(grantId) && (
        isAdmin() || (
          isSignedIn() && (
            resource.data.teacherUid == request.auth.uid ||
            resource.data.studentUid == request.auth.uid ||
            (request.auth.token.email_verified == true && resource.data.studentEmail == request.auth.token.email)
          )
        )
      );
      allow list: if isAdmin() || (
        isSignedIn() && (
          resource.data.teacherUid == request.auth.uid ||
          resource.data.studentUid == request.auth.uid ||
          (request.auth.token.email_verified == true && resource.data.studentEmail == request.auth.token.email)
        )
      );
      allow create: if isSignedIn() &&
        isValidId(grantId) &&
        isValidClassroomGrant(request.resource.data) &&
        request.resource.data.grantId == grantId && (
          (isAdmin() && request.resource.data.status in ['active', 'pending']) || (
            request.resource.data.teacherUid == request.auth.uid &&
            request.resource.data.method == 'teacher_email' &&
            request.resource.data.status in ['active', 'pending'] &&
            isTeacherSchoolEntitled(request.auth.uid)
          ) || (
            request.resource.data.method == 'invite_code' &&
            request.resource.data.status == 'active' &&
            request.resource.data.studentUid == request.auth.uid &&
            (
              request.resource.data.studentEmail == '' ||
              request.auth.token.firebase.sign_in_provider == 'facebook.com' ||
              (request.auth.token.email_verified == true && request.resource.data.studentEmail == request.auth.token.email)
            ) &&
            exists(/databases/$(database)/documents/classroom_invites/$(request.resource.data.inviteCode)) &&
            get(/databases/$(database)/documents/classroom_invites/$(request.resource.data.inviteCode)).data.active == true &&
            get(/databases/$(database)/documents/classroom_invites/$(request.resource.data.inviteCode)).data.get('inviteCodeLocked', false) != true &&
            get(/databases/$(database)/documents/classroom_invites/$(request.resource.data.inviteCode)).data.teacherUid == request.resource.data.teacherUid &&
            get(/databases/$(database)/documents/classroom_invites/$(request.resource.data.inviteCode)).data.seatCount < get(/databases/$(database)/documents/classroom_invites/$(request.resource.data.inviteCode)).data.maxSeats &&
            getAfter(/databases/$(database)/documents/classroom_invites/$(request.resource.data.inviteCode)).data.seatCount ==
              get(/databases/$(database)/documents/classroom_invites/$(request.resource.data.inviteCode)).data.seatCount + 1
          )
        );
      allow update: if isSignedIn() &&
        isValidId(grantId) &&
        isValidClassroomGrant(request.resource.data) &&
        request.resource.data.grantId == resource.data.grantId &&
        request.resource.data.teacherUid == resource.data.teacherUid &&
        request.resource.data.studentEmail == resource.data.studentEmail &&
        request.resource.data.grantedAt == resource.data.grantedAt && (
          isAdmin() || (
            resource.data.teacherUid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'studentName', 'displayName', 'groupName', 'className',
              'inviteCode', 'method', 'activatedAt', 'updatedAt'
            ])
          ) || (
            (
              resource.data.studentUid == request.auth.uid ||
              (request.auth.token.email_verified == true && resource.data.studentEmail == request.auth.token.email)
            ) &&
            request.resource.data.studentUid == request.auth.uid &&
            (
              (resource.data.status == 'active' && request.resource.data.status == 'active') ||
              (resource.data.status == 'pending' && request.resource.data.status == 'active')
            ) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'studentUid', 'studentName', 'status', 'activatedAt',
              'exploredSiteIds', 'exploredCount', 'quizAttempts', 'bestQuizScore', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(grantId) && (
        isAdmin() || (isSignedIn() && resource.data.teacherUid == request.auth.uid)
      );
    }

    // -------------------------------------------------------------
    // Real-time 3D Visibility CMS, System Settings, Events & Audit Logs
    // -------------------------------------------------------------
    match /cms_heritage_sites/{siteId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(siteId) && isValidCmsHeritageSite3D(request.resource.data);
      allow delete: if isAdmin();
    }

    match /system_settings/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(docId) && isValidSystemSetting3DConfig(request.resource.data);
      allow delete: if isAdmin();
    }

    match /cms_events/{eventId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(eventId) && isValidCmsEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    match /activity_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() &&
        isValidId(logId) &&
        isValidActivityLog(request.resource.data) &&
        request.resource.data.id == logId &&
        (isAdmin() || request.resource.data.actorUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // Default Deny Catch-All
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
